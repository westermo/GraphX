<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material design-specific resources for GraphX controls.
         These serve as fallbacks when Material.Avalonia theme resources
         are not available, and as semantic aliases for graph styling. -->

    <SolidColorBrush x:Key="GraphXMaterialVertexBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="GraphXMaterialVertexBorder" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="GraphXMaterialVertexHoverBackground" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="GraphXMaterialVertexSelectedBorder" Color="#FF6200EE" />
    <SolidColorBrush x:Key="GraphXMaterialEdgeForeground" Color="#DE000000" />
    <SolidColorBrush x:Key="GraphXMaterialLabelForeground" Color="#DE000000" />

    <!-- Compatibility resources: provide Fluent-named keys so that apps
         originally styled for Fluent render correctly under Material theme.
         These map to Material Design light-theme equivalents. -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#1F000000" />
    <SolidColorBrush x:Key="ButtonText" Color="#DE000000" />
    <SolidColorBrush x:Key="WindowBackground" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="SystemRegionBrush" Color="#FFF5F5F5" />

</ResourceDictionary>
